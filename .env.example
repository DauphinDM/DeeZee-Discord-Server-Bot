# Deezee Server Bot - configuration template.
# Copy this file to .env and fill in the values. .env is git-ignored.

# --- Discord ---------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=your_bot_token_here

# Guilds this bot is allowed in, comma separated. Slash commands sync to each
# one instantly instead of taking up to an hour to propagate globally, and the
# bot leaves any guild not on this list. Config is keyed by guild_id, so a dev
# guild and the live guild never share settings.
GUILD_IDS=000000000000000000

# Guild treated as the development server: verbose logging, no leave-on-join
# check while you iterate, and destructive-command confirmations shortened.
# Leave blank if you do not want one.
DEV_GUILD_ID=

# Root owner(s), comma separated. Absolute, unconditional authority over the
# bot. Nothing at runtime can demote, blacklist, ignore, deny or moderate a root
# owner - not another owner, not the Discord server owner, not an Administrator.
# Only changeable by editing this file and restarting.
ROOT_OWNER_IDS=000000000000000000

# Secondary owners, comma separated. Full bot power, but subordinate to root:
# they cannot target a root owner with any command, cannot edit either owner
# list, and cannot deny a root owner access to anything.
OWNER_IDS=000000000000000000

# --- Bot behaviour ---------------------------------------------------------
DEFAULT_PREFIX=?
DATABASE_PATH=data/deezee.db
LOG_LEVEL=INFO

# --- Optional external services -------------------------------------------
# Google Safe Browsing v5, used by ?scanlinks for links that are not on the
# trusted-domain list. Free, non-commercial use only.
#
# How to get one:
#   1. https://console.cloud.google.com/ and create a project
#   2. APIs & Services -> Library -> "Safe Browsing API" -> Enable
#   3. APIs & Services -> Credentials -> Create credentials -> API key
#   4. Edit the key -> API restrictions -> restrict it to Safe Browsing API
#
# Leave blank to disable tier-3 scanning. The bundled trusted-domain list and
# the offline phishing blocklist keep working without it.
GOOGLE_SAFE_BROWSING_KEY=
